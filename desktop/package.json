{
  "name": "emilie-desktop",
  "productName": "Emilie",
  "version": "0.1.0",
  "private": true,
  "description": "Emilie desktop app: the Emilie coding agent in a window like the Claude Code desktop app",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "lucide-react": "1.68.0",
    "marked": "18.1.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
